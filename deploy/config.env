# shellcheck shell=bash
# =============================================================================
# OpenClaw AI gateway — Azure VM configuration
# -----------------------------------------------------------------------------
# Edit here, or override any value by exporting it before running a script:
#
#     OPENCLAW_MODEL=anthropic/claude-... ./deploy/setup.sh
#
# Every value uses ${VAR:-default}, so an exported value always wins.
# Docs: https://docs.openclaw.ai  •  Repo: https://github.com/openclaw/openclaw
# =============================================================================

# Load local secrets (gitignored) if present, so keys don't have to be exported
# by hand. DEPLOY_DIR is set by lib.sh before this file is sourced.
for _sf in "${DEPLOY_DIR:-.}/../secrets.env" "${DEPLOY_DIR:-.}/secrets.env"; do
  # shellcheck source=/dev/null
  [ -f "${_sf}" ] && . "${_sf}"
done
unset _sf

# --- OpenClaw package ------------------------------------------------------
export OPENCLAW_PKG="${OPENCLAW_PKG:-openclaw@latest}"

# Node.js major version to install. 24 is recommended; minimum is 22.19.
export NODE_MAJOR="${NODE_MAJOR:-24}"

# Gateway listen port (the local dashboard/API). 18789 is the OpenClaw default.
export OPENCLAW_PORT="${OPENCLAW_PORT:-18789}"

# --- Agent backend / provider ----------------------------------------------
# Which agent runtime the gateway uses:
#   codex  -> OpenAI Codex app-server (bundled @openclaw/codex plugin)   [default]
#   claude -> Anthropic / Claude
export OPENCLAW_BACKEND="${OPENCLAW_BACKEND:-codex}"

# Codex plugin package (installed when OPENCLAW_BACKEND=codex).
export OPENCLAW_CODEX_PLUGIN="${OPENCLAW_CODEX_PLUGIN:-@openclaw/codex}"

# Config lives in ~/.openclaw/openclaw.json. Model format is "<provider>/<model-id>".
export OPENCLAW_DIR="${OPENCLAW_DIR:-${HOME}/.openclaw}"
export OPENCLAW_CONFIG="${OPENCLAW_CONFIG:-${OPENCLAW_DIR}/openclaw.json}"

# Model. For the codex backend the Codex app-server handles model discovery, so
# this is mainly used by the claude backend. Adjust per https://docs.openclaw.ai.
export OPENCLAW_MODEL="${OPENCLAW_MODEL:-anthropic/claude-sonnet-4-6}"

# Provider credentials — supply your own; NEVER commit them. Export in your shell:
#   Codex:  export OPENAI_API_KEY=sk-...        (or log in via ChatGPT/Codex during onboard)
#   Claude: export ANTHROPIC_API_KEY=sk-ant-...
export OPENAI_API_KEY="${OPENAI_API_KEY:-}"
export ANTHROPIC_API_KEY="${ANTHROPIC_API_KEY:-}"

# --- GitHub integration ----------------------------------------------------
# Connect the agent to GitHub via the GitHub plugin. Set OPENCLAW_GITHUB=0 to skip.
export OPENCLAW_GITHUB="${OPENCLAW_GITHUB:-1}"
# Plugin package (follows the @openclaw/<name> convention like @openclaw/codex;
# confirm the exact name in the OpenClaw plugin directory if it fails to add).
export OPENCLAW_GITHUB_PLUGIN="${OPENCLAW_GITHUB_PLUGIN:-@openclaw/github}"
# Fine-grained GitHub PAT (scopes: repo + read:org). Read from the environment,
# never written to openclaw.json. Put it in secrets.env. NEVER commit it.
export GITHUB_TOKEN="${GITHUB_TOKEN:-}"

# --- Remote access (from your Mac/laptop) ----------------------------------
# SSH target of the VM, used by connect.sh to tunnel the dashboard to your Mac.
# e.g. VM_HOST=azureuser@20.30.40.50  (public IP from the Azure Portal)
export VM_HOST="${VM_HOST:-}"

# Azure resource identity + admin user, used by vm-ssh-setup.sh to print the
# exact 'az vm user update' command. These match the openclaw-vm you linked.
export AZ_RESOURCE_GROUP="${AZ_RESOURCE_GROUP:-openclaw-vm_group}"
export AZ_VM_NAME="${AZ_VM_NAME:-openclaw-vm}"
export VM_USER="${VM_USER:-azureuser}"

# Local SSH private key to use/create for the VM.
export SSH_KEY="${SSH_KEY:-${HOME}/.ssh/openclaw_vm}"
