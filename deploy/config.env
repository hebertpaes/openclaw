# =============================================================================
# OpenClaw deploy configuration
# -----------------------------------------------------------------------------
# Edit these values, or override any of them by exporting the same variable
# before running a script, e.g.:
#
#     OPENCLAW_HOME=/opt/openclaw ./deploy/setup.sh
#
# Every variable below uses ${VAR:-default}, so an exported value always wins.
# =============================================================================

# --- OpenClaw source -------------------------------------------------------
# Upstream engine (reimplementation of Captain Claw, 1997).
export OPENCLAW_REPO="${OPENCLAW_REPO:-https://github.com/pjasicek/OpenClaw.git}"
export OPENCLAW_BRANCH="${OPENCLAW_BRANCH:-master}"

# Where the engine is cloned and built on the VM.
export OPENCLAW_HOME="${OPENCLAW_HOME:-${HOME}/OpenClaw}"
export BUILD_DIR="${BUILD_DIR:-${OPENCLAW_HOME}/build}"

# The upstream CMake places the binary + assets here (CMAKE_RUNTIME_OUTPUT_DIRECTORY=../Build_Release).
# CLAW.REZ and ASSETS.ZIP must live in this directory; the game runs from here.
export RELEASE_DIR="${RELEASE_DIR:-${OPENCLAW_HOME}/Build_Release}"
export OPENCLAW_BIN="${OPENCLAW_BIN:-${RELEASE_DIR}/openclaw}"

# --- "Download" folder -----------------------------------------------------
# Folder that organize-assets.sh scans for the original game archive (CLAW.REZ).
# Drop CLAW.REZ (or a zip/folder containing it) here, then run organize-assets.sh.
export DOWNLOADS_DIR="${DOWNLOADS_DIR:-${HOME}/Downloads}"

# --- Headless display (Azure VMs have no monitor) --------------------------
# OpenClaw is a graphical SDL2 app, so on a server we render to a virtual X
# display (Xvfb) and optionally expose it over VNC so you can play remotely.
export DISPLAY_NUM="${DISPLAY_NUM:-:99}"
export SCREEN_GEOMETRY="${SCREEN_GEOMETRY:-1280x720x24}"

# Set ENABLE_VNC=1 to start x11vnc bound to localhost (connect via SSH tunnel).
# Set ENABLE_VNC=0 to run purely headless (e.g. for a smoke test).
export ENABLE_VNC="${ENABLE_VNC:-1}"
export VNC_PORT="${VNC_PORT:-5900}"

# VNC_EXPOSE controls WHERE x11vnc listens:
#   0 (default, SECURE): localhost only — reach it through an SSH tunnel.
#   1 (NETWORK):         all interfaces / the VM's local IP, so a VNC client can
#                        connect to vnc://<vm-ip>:VNC_PORT WITHOUT a tunnel.
# Exposing on the network REQUIRES a password (VNC_PASSWORD) and an inbound
# rule for VNC_PORT in the Azure Network Security Group. Prefer the SSH tunnel.
export VNC_EXPOSE="${VNC_EXPOSE:-0}"
export VNC_PASSWORD="${VNC_PASSWORD:-}"

# --- Remote connection (from your Mac/laptop) ------------------------------
# VM_HOST is the SSH target of the Azure VM, used by connect.sh to open the
# tunnel. Set it to user@ip, e.g. VM_HOST=azureuser@20.30.40.50
# Find the VM's public IP in the Azure Portal (VM overview), or run connect.sh
# on the VM itself to print its local IP.
export VM_HOST="${VM_HOST:-}"

# --- Build tuning ----------------------------------------------------------
export MAKE_JOBS="${MAKE_JOBS:-$(nproc 2>/dev/null || echo 2)}"
