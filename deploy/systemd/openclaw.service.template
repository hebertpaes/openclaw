[Unit]
Description=OpenClaw (Captain Claw) game engine — headless via Xvfb/VNC
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__RELEASE_DIR__
# run.sh starts Xvfb (+ x11vnc on localhost) and then the game.
ExecStart=/usr/bin/env bash __DEPLOY_DIR__/run.sh --headless
Restart=on-failure
RestartSec=5
# Give SDL a sane home for config/save files.
Environment=HOME=__HOME__

[Install]
WantedBy=multi-user.target
