# =============================================================================
# OpenClaw credentials — TEMPLATE
# -----------------------------------------------------------------------------
# Copy this file to "secrets.env" (which is gitignored) and fill in your values.
# The deploy/ (VM) and mac/ scripts load secrets.env automatically, so you do
# NOT need to export these by hand each time.
#
#     cp secrets.env.example secrets.env
#     # edit secrets.env, then:
#     ./deploy/setup.sh        # or ./mac/setup.sh
#
# NEVER commit secrets.env — it holds real keys. (.gitignore already blocks it.)
# =============================================================================

# --- Agent backend ---------------------------------------------------------
# codex (default) or claude
export OPENCLAW_BACKEND=codex

# --- Provider API keys -----------------------------------------------------
# Codex backend -> OpenAI (or log in via ChatGPT/Codex during 'openclaw onboard')
export OPENAI_API_KEY=

# Claude backend -> Anthropic
export ANTHROPIC_API_KEY=

# --- GitHub integration ----------------------------------------------------
# Connect the agent to GitHub (1 = on). Token is a fine-grained PAT with the
# repo + read:org scopes — https://github.com/settings/tokens
export OPENCLAW_GITHUB=1
export GITHUB_TOKEN=

# --- Remote access (Mac -> VM) ---------------------------------------------
# SSH target used by deploy/connect.sh, e.g. azureuser@20.30.40.50
export VM_HOST=
