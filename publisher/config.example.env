# =============================================================================
# openclaw-publisher — credenciais (TEMPLATE)
# -----------------------------------------------------------------------------
# Copie para "publisher/config.env" (gitignored) e preencha:
#
#     cp publisher/config.example.env publisher/config.env
#     # edite publisher/config.env, depois:
#     node publisher/syndicate.js --dry-run
#
# NUNCA faça commit do config.env — ele tem chaves reais. (.gitignore bloqueia.)
# As linhas usam "export KEY=value" para também poderem ser `source`das no bash.
# =============================================================================

# --- Site / Ghost ----------------------------------------------------------
export GHOST_URL=https://odiapolitico.com.br
export SITE_URL=https://odiapolitico.com.br

# Admin API key de uma Custom Integration do Ghost (formato id:secret).
# Ghost Admin → Settings → Integrations → Add custom integration.
# (NÃO é a senha de login do admin — é a "Admin API Key".)
export GHOST_ADMIN_API_KEY=

# Content API key (read-only) da mesma integração — usada para ler posts.
export GHOST_CONTENT_API_KEY=

# Opcional: versão da API (padrão v5.0).
# export GHOST_API_VERSION=v5.0

# --- Seleção de plataformas ------------------------------------------------
# Coloque 0 para desligar uma plataforma mesmo com credenciais presentes.
export PLATFORM_X=1
export PLATFORM_FACEBOOK=1
export PLATFORM_INSTAGRAM=1
export PLATFORM_WHATSAPP=1
export PLATFORM_TELEGRAM=1

# Versão da Graph API (Meta) — Facebook / Instagram / WhatsApp.
# export GRAPH_API_VERSION=v21.0

# --- X (Twitter) — OAuth 1.0a (app com permissão de escrita) ---------------
export X_API_KEY=
export X_API_SECRET=
export X_ACCESS_TOKEN=
export X_ACCESS_SECRET=

# --- Facebook Page (Graph API) ---------------------------------------------
export FB_PAGE_ID=
export FB_PAGE_ACCESS_TOKEN=

# --- Instagram (conta Business ligada à Page) ------------------------------
export IG_USER_ID=
export IG_ACCESS_TOKEN=

# --- WhatsApp Cloud API ----------------------------------------------------
# ⚠️ Só envia para quem deu OPT-IN. Fora da janela de 24h é obrigatório usar
#    um template aprovado (WHATSAPP_TEMPLATE). Envio em massa não solicitado
#    viola a política do WhatsApp e pode banir o número.
export WHATSAPP_PHONE_ID=
export WHATSAPP_TOKEN=
# Lista de destinatários opt-in, separados por vírgula (formato E.164):
export WHATSAPP_RECIPIENTS=
# Template aprovado para mensagens iniciadas pelo negócio (opcional):
# export WHATSAPP_TEMPLATE=
# export WHATSAPP_TEMPLATE_LANG=pt_BR

# --- Telegram (Bot API) ----------------------------------------------------
# Crie um bot com @BotFather e adicione-o como admin do canal.
export TELEGRAM_BOT_TOKEN=
# Canal/grupo destino: @usuariodocanal ou id numérico (ex: -1001234567890)
export TELEGRAM_CHAT_ID=

# --- Webhook (Ghost post.published → sindicaliza sozinho) -------------------
# export WEBHOOK_PORT=3333
# export WEBHOOK_PATH=/webhook/ghost
# Segredo do webhook do Ghost (recomendado) — valida X-Ghost-Signature:
export GHOST_WEBHOOK_SECRET=
