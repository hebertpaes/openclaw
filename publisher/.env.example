# Copy to publisher/.env (gitignored) and fill in. Loaded by GitHub Actions from
# repo secrets, or locally with:  set -a; . publisher/.env; set +a

# --- Ghost target site -----------------------------------------------------
# Base URL of your Ghost site (NOT the /ghost admin path).
GHOST_ADMIN_API_URL=https://odiapolitico.com.br
# Admin API key from Ghost Admin -> Settings -> Integrations -> Add custom
# integration. Format "id:secret". NEVER commit this.
GHOST_ADMIN_API_KEY=

# --- Behaviour -------------------------------------------------------------
# draft (default, safe: review before going live) or published (full auto).
POST_STATUS=draft
# Set DRY_RUN=1 to fetch + build posts but NOT send them to Ghost.
DRY_RUN=0
# Max posts created per run (rate limit).
MAX_PER_RUN=5
